outputs/**/qpos_*.npy
outputs/text_cache.npz
__pycache__/
*.pyc

# Transient run logs from background jobs. Never committed: they are session-scoped and were
# the source of a mixed-artifact confusion once already (a log describing a margin-0.18 build
# sitting beside margin-0.12 metadata).
*.log
outputs/*.log
outputs/**/motions.pkl
outputs/.duck_dataset_v3_*.building/

# Resumable, machine-local physics campaign state.  Durable ledgers and diagnoses belong in
# outputs/ and docs/ respectively; raw motion pickles, achieved-state arrays, and subprocess
# logs are regenerable campaign state and should not make the worktree permanently dirty.
/run/
